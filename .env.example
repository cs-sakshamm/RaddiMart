# RADDIMART browser-safe environment variables.
# Copy this file to .env and fill in values for local development only.
# Never put a Supabase service-role or secret key in a VITE_ variable.

VITE_SUPABASE_URL=https://gzpjxyvhozlwwkqrxhok.supabase.co
VITE_SUPABASE_ANON_KEY=

# Newer Supabase projects may issue a publishable key instead of, or alongside,
# the anonymous key. If set, it takes precedence over VITE_SUPABASE_ANON_KEY.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_BHQ27dMtwHqH8xjfYGE7aw_0yxxQJg5
